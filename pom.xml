<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>dns-test-tool</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>DNS延迟测试工具</name>
    <description>DNS服务器延迟测试工具 - 现代化Swing版</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <main.class>org.example.dns.DnsTestApplication</main.class>
        <!-- 新增属性：控制是否包含dig工具 -->
        <include.dig.tools>true</include.dig.tools>
    </properties>

    <dependencies>
        <!-- DNS查询库 -->
        <dependency>
            <groupId>dnsjava</groupId>
            <artifactId>dnsjava</artifactId>
            <version>3.5.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/dnsjava-3.5.1.jar</systemPath>
        </dependency>

        <!-- 日志库 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/slf4j-api-1.7.36.jar</systemPath>
        </dependency>

        <!-- FlatLaf现代化UI主题 -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.2.5</version>
        </dependency>

        <!-- emoji-java库 - 处理emoji表情字符 -->
        <dependency>
            <groupId>com.vdurmont</groupId>
            <artifactId>emoji-java</artifactId>
            <version>5.1.1</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>dns-test-tool</finalName>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
                <!-- 根据profile排除大文件 -->
                <excludes>
                    <exclude>dig_path/**</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <!-- Maven编译插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- 添加exec插件以便于运行主类 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <!-- Maven Shade插件 - 创建包含所有依赖的Fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/LICENSE*</exclude>
                                        <exclude>META-INF/NOTICE*</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- Profiles for different packaging options -->
    <profiles>
        <!-- 快速开发模式 - 排除大文件 -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <excludes>
                            <exclude>dig_path/**</exclude>
                        </excludes>
                    </resource>
                </resources>
            </build>
        </profile>

        <!-- 完整资源模式 - 包含所有文件 -->
        <profile>
            <id>full</id>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <includes>
                            <include>**/*</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>

        <!-- Profile for creating a standard EXE with Launch4j (requires JRE) -->
        <profile>
            <id>windows-exe</id>
            <build>
                <plugins>
                    <!-- Launch4j Maven Plugin -->
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>2.1.2</version>
                        <executions>
                            <execution>
                                <id>l4j-exe</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>launch4j</goal>
                                </goals>
                                <configuration>
                                    <headerType>gui</headerType>
                                    <jar>${project.build.directory}/${project.build.finalName}.jar</jar>
                                    <outfile>${project.build.directory}/DNS延迟测试工具_launch4j.exe</outfile>
                                    <icon>src/main/resources/icon.ico</icon>
                                    <downloadUrl>https://adoptium.net/</downloadUrl>
                                    <classPath>
                                        <mainClass>${main.class}</mainClass>
                                    </classPath>
                                    <jre>
                                        <minVersion>17.0.0</minVersion>
                                        <initialHeapSize>128</initialHeapSize>
                                        <maxHeapSize>1024</maxHeapSize>
                                    </jre>
                                    <versionInfo>
                                        <fileVersion>2.0.0.0</fileVersion>
                                        <txtFileVersion>${project.version}</txtFileVersion>
                                        <fileDescription>DNS延迟测试工具</fileDescription>
                                        <copyright>2024</copyright>
                                        <productVersion>2.0.0.0</productVersion>
                                        <txtProductVersion>${project.version}</txtProductVersion>
                                        <productName>DNS延迟测试工具</productName>
                                        <companyName>DNS Test Tool</companyName>
                                        <internalName>dns-test-tool</internalName>
                                        <originalFilename>DNS延迟测试工具.exe</originalFilename>
                                    </versionInfo>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profile for creating a standalone application with an embedded JRE using jpackage -->
        <profile>
            <id>standalone</id>
            <build>
                <plugins>
                    <!-- 使用 antrun 直接调用系统 jpackage，避免第三方插件仓库不可用问题 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>run-jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <echo>Running jpackage to build standalone app-image with embedded JRE...</echo>
                                        <!-- 先清理可能存在的dist目录 -->
                                        <delete dir="${project.build.directory}/dist" failonerror="false"/>
                                        <mkdir dir="${project.build.directory}/dist"/>
                                        <!-- 创建临时输入目录 -->
                                        <mkdir dir="${project.build.directory}/jpackage-input"/>
                                        <!-- 复制JAR到临时目录 -->
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              todir="${project.build.directory}/jpackage-input"/>
                                        <!-- 运行jpackage -->
                                        <exec executable="jpackage" dir="${project.build.directory}" failonerror="true">
                                            <arg value="--name"/>
                                            <arg value="DNS延迟测试工具"/>
                                            <arg value="--input"/>
                                            <arg value="jpackage-input"/>
                                            <arg value="--main-jar"/>
                                            <arg value="${project.build.finalName}.jar"/>
                                            <arg value="--main-class"/>
                                            <arg value="${main.class}"/>
                                            <arg value="--type"/>
                                            <arg value="app-image"/>
                                            <arg value="--app-version"/>
                                            <arg value="${project.version}"/>
                                            <arg value="--dest"/>
                                            <arg value="dist"/>
                                            <arg value="--icon"/>
                                            <arg value="../src/main/resources/icon.ico"/>
                                            <arg value="--vendor"/>
                                            <arg value="DNS Test Tool"/>
                                            <arg value="--java-options"/>
                                            <arg value="-Dfile.encoding=UTF-8"/>
                                            <arg value="--verbose"/>
                                        </exec>
                                        <!-- 压缩生成的 app-image 便于分发 -->
                                        <zip destfile="${project.build.directory}/dist/DNS延迟测试工具-standalone.zip"
                                             basedir="${project.build.directory}/dist/DNS延迟测试工具"/>
                                        <!-- 清理临时目录 -->
                                        <delete dir="${project.build.directory}/jpackage-input"/>
                                        <echo>Standalone application created at: ${project.build.directory}/dist/DNS延迟测试工具</echo>
                                        <echo>Archive created at: ${project.build.directory}/dist/DNS延迟测试工具-standalone.zip</echo>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 轻量级EXE - 仅包含核心功能，无dig工具 -->
        <profile>
            <id>lightweight-exe</id>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <excludes>
                            <exclude>dig_path/**</exclude>
                        </excludes>
                    </resource>
                </resources>
                <plugins>
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>2.1.2</version>
                        <executions>
                            <execution>
                                <id>l4j-exe-lightweight</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>launch4j</goal>
                                </goals>
                                <configuration>
                                    <headerType>gui</headerType>
                                    <jar>${project.build.directory}/${project.build.finalName}.jar</jar>
                                    <outfile>${project.build.directory}/DNS延迟测试工具_轻量版.exe</outfile>
                                    <icon>src/main/resources/icon.ico</icon>
                                    <downloadUrl>https://adoptium.net/</downloadUrl>
                                    <classPath>
                                        <mainClass>${main.class}</mainClass>
                                    </classPath>
                                    <jre>
                                        <minVersion>17.0.0</minVersion>
                                        <initialHeapSize>64</initialHeapSize>
                                        <maxHeapSize>512</maxHeapSize>
                                    </jre>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- GraalVM Native Image profile - for creating a native executable -->
        <profile>
            <id>native</id>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <excludes>
                            <exclude>dig_path/**</exclude>
                        </excludes>
                    </resource>
                </resources>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.9.28</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>dns-test-tool</imageName>
                            <mainClass>org.example.dns.DnsTestApplication</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <!-- 延迟初始化AWT/Swing相关类 -->
                                <buildArg>--initialize-at-run-time=sun.awt.windows.WMouseInfoPeer</buildArg>
                                <buildArg>--initialize-at-run-time=sun.awt.AWTAutoShutdown</buildArg>
                                <buildArg>--initialize-at-run-time=sun.awt.shell.Win32ShellFolderManager2</buildArg>
                                <buildArg>--initialize-at-run-time=sun.awt.shell.Win32ShellFolder2</buildArg>
                                <buildArg>--initialize-at-run-time=sun.awt.shell.ShellFolder</buildArg>
                                <buildArg>--initialize-at-run-time=javax.swing.JFileChooser</buildArg>
                                <buildArg>--initialize-at-run-time=javax.swing.filechooser.FileSystemView</buildArg>
                                <buildArg>--initialize-at-run-time=java.awt.Toolkit</buildArg>
                                <buildArg>--initialize-at-run-time=java.awt.GraphicsEnvironment</buildArg>
                                <!-- Swing相关包延迟初始化 -->
                                <buildArg>--initialize-at-run-time=javax.swing</buildArg>
                                <buildArg>--initialize-at-run-time=java.awt</buildArg>
                                <buildArg>--initialize-at-run-time=sun.awt</buildArg>
                                <buildArg>--initialize-at-run-time=sun.java2d</buildArg>
                                <buildArg>--initialize-at-run-time=sun.font</buildArg>
                                <!-- Windows特定的AWT类 -->
                                <buildArg>--initialize-at-run-time=sun.awt.windows</buildArg>
                                <buildArg>--initialize-at-run-time=sun.java2d.d3d</buildArg>
                                <buildArg>--initialize-at-run-time=sun.java2d.opengl</buildArg>
                                <!-- 排除问题类 -->
                                <buildArg>--initialize-at-run-time=com.sun.imageio.plugins.jpeg.JPEGImageReader</buildArg>
                                <buildArg>--initialize-at-run-time=com.sun.imageio.plugins.jpeg.JPEGImageWriter</buildArg>
                                <!-- FlatLaf相关 -->
                                <buildArg>--initialize-at-run-time=com.formdev.flatlaf</buildArg>
                                <!-- 启用所有反射配置 -->
                                <buildArg>--enable-all-security-services</buildArg>
                                <buildArg>--enable-http</buildArg>
                                <buildArg>--enable-https</buildArg>
                                <!-- AWT支持 -->
                                <buildArg>--enable-preview</buildArg>
                                <buildArg>-H:+AddAllCharsets</buildArg>
                                <buildArg>-H:+IncludeAllLocales</buildArg>
                                <!-- 报告异常堆栈 -->
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <!-- 打印详细信息 -->
                                <buildArg>--verbose</buildArg>
                                <!-- 允许不完整类路径 -->
                                <buildArg>--allow-incomplete-classpath</buildArg>
                                <!-- 内存设置 -->
                                <buildArg>-J-Xmx4g</buildArg>
                                <!-- 强制非无头模式 -->
                                <buildArg>-J-Djava.awt.headless=false</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
