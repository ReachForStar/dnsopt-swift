{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNS延迟测试工具",
  "version": "3.0.0",
  "identifier": "com.xyx.dns-test-tool",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "DNS延迟测试工具 v3.0.0",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "DNS服务器延迟批量测试与一键设置工具"
  }
}
